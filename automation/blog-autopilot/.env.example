# Copy to .env on the server — never commit .env
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT=your_appwrite_project_id
APPWRITE_KEY=your_appwrite_server_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
OMNIROUTE_API_KEY=your_omniroute_api_key
OMNIROUTE_FULL_KEY=your_omniroute_full_key
LLM_MODEL=auto/best-chat
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
INDEXNOW_KEY=your_indexnow_key
